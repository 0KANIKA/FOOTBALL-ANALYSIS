"""Build a reproducible, multi-dimensional player-performance data layer.

This script only reads the existing local datasets. Original files and model
artifacts are not modified. Derived outputs are written to
performance_analysis_outputs/.
"""

from __future__ import annotations

import json
import os
import re
import unicodedata
import gc
from collections import Counter, defaultdict
from pathlib import Path

import numpy as np
import pandas as pd


ROOT = Path(__file__).resolve().parent
ARCHIVE = ROOT / "archive"
SB_ROOT = ROOT / "open-data-master" / "open-data-master"
OUT = ROOT / "performance_analysis_outputs"
OUT.mkdir(exist_ok=True)

MIN_MINUTES = 450
MIN_APPEARANCES = 5
MIN_PEER_GROUP = 10


def read_csv(name: str, usecols=None) -> pd.DataFrame:
    path = ARCHIVE / name if name in {
        "appearances.csv", "games.csv", "game_lineups.csv", "players.csv",
        "player_valuations.csv", "transfers.csv", "game_events.csv"
    } else ROOT / name
    if not path.exists():
        raise FileNotFoundError(f"Required local file is missing: {path}")
    return pd.read_csv(path, usecols=usecols, low_memory=False)


def norm_text(value) -> str:
    if pd.isna(value):
        return ""
    value = unicodedata.normalize("NFKD", str(value)).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", " ", value.lower()).strip()


def key_columns(df: pd.DataFrame) -> pd.Series:
    """Natural transfer key; independent of file row order."""
    fee = pd.to_numeric(df.get("transfer_fee", 0), errors="coerce").fillna(-1).round(2)
    season = df.get("transfer_season", "").fillna("").astype(str)
    date = pd.to_datetime(df["transfer_date"], errors="coerce").dt.strftime("%Y-%m-%d")
    return (
        df["player_id"].astype("Int64").astype(str) + "|" + date.fillna("") + "|"
        + df["from_club_id"].astype("Int64").astype(str) + "|"
        + df["to_club_id"].astype("Int64").astype(str) + "|"
        + season + "|" + fee.astype(str)
    )


def safe_rate(num, denom, multiplier=90.0):
    num = pd.to_numeric(num, errors="coerce")
    denom = pd.to_numeric(denom, errors="coerce")
    return np.where(denom > 0, num * multiplier / denom, np.nan)


def add_rates(df: pd.DataFrame, prefix: str = "") -> pd.DataFrame:
    p = f"{prefix}_" if prefix else ""
    df[f"{p}goal_contributions"] = df[f"{p}goals"] + df[f"{p}assists"]
    df[f"{p}goals_per90"] = safe_rate(df[f"{p}goals"], df[f"{p}minutes"])
    df[f"{p}assists_per90"] = safe_rate(df[f"{p}assists"], df[f"{p}minutes"])
    df[f"{p}goal_contributions_per90"] = safe_rate(df[f"{p}goal_contributions"], df[f"{p}minutes"])
    df[f"{p}minutes_per_appearance"] = safe_rate(df[f"{p}minutes"], df[f"{p}appearances"], 1.0)
    df[f"{p}yellow_cards_per90"] = safe_rate(df[f"{p}yellow_cards"], df[f"{p}minutes"])
    df[f"{p}red_cards_per90"] = safe_rate(df[f"{p}red_cards"], df[f"{p}minutes"])
    df[f"{p}cards_per_appearance"] = np.where(
        df[f"{p}appearances"] > 0,
        (df[f"{p}yellow_cards"] + df[f"{p}red_cards"]) / df[f"{p}appearances"],
        np.nan,
    )
    return df


def reliability(row, minutes_col, appearances_col, peer_col=None) -> str:
    warnings = []
    if pd.isna(row.get(minutes_col)) or row.get(minutes_col, 0) < MIN_MINUTES:
        warnings.append(f"minutes<{MIN_MINUTES}")
    if pd.isna(row.get(appearances_col)) or row.get(appearances_col, 0) < MIN_APPEARANCES:
        warnings.append(f"appearances<{MIN_APPEARANCES}")
    if peer_col and row.get(peer_col, 0) < MIN_PEER_GROUP:
        warnings.append(f"peer_n<{MIN_PEER_GROUP}")
    return ";".join(warnings) if warnings else "ok"


def attach_percentiles(df: pd.DataFrame, rate_cols: list[str], suffix: str = "") -> pd.DataFrame:
    group_cols = ["position", "sub_position"] if suffix == "sub_position" else ["position"]
    group_name = "_".join(group_cols)
    eligible = (df["minutes"] >= MIN_MINUTES) & (df["appearances"] >= MIN_APPEARANCES)
    for col in rate_cols:
        out = f"percentile_{col}_{suffix or 'position'}"
        df[out] = np.nan
        valid = eligible & df[col].notna()
        if valid.any():
            df.loc[valid, out] = (
                df.loc[valid].groupby(group_cols, dropna=False)[col]
                .rank(pct=True, method="average") * 100
            )
    counts = df[eligible].groupby(group_cols, dropna=False).size().rename(f"{group_name}_peer_n")
    df = df.merge(counts.reset_index(), on=group_cols, how="left", validate="many_to_one")
    return df


def aggregate_window(app_groups, row, start, end, club_id=None):
    g = app_groups.get(int(row.player_id))
    if g is None or g.empty:
        return {"appearances": 0, "minutes": 0.0, "goals": 0.0, "assists": 0.0,
                "yellow_cards": 0.0, "red_cards": 0.0}
    mask = (g["date"] >= start) & (g["date"] <= end)
    if club_id is not None:
        mask &= g["player_club_id"] == int(club_id)
    x = g.loc[mask]
    return {
        "appearances": int(x["game_id"].nunique()),
        "minutes": float(x["minutes_played"].sum()),
        "goals": float(x["goals"].sum()),
        "assists": float(x["assists"].sum()),
        "yellow_cards": float(x["yellow_cards"].sum()),
        "red_cards": float(x["red_cards"].sum()),
    }


def load_transfer_cohort():
    cohort = read_csv("professional_transfer_dataset.csv")
    target = read_csv("post_transfer_performance.csv")
    rich = read_csv("rich_team_context_dataset.csv")
    cohort["_key"] = key_columns(cohort)
    target["_key"] = key_columns(target)
    if cohort["_key"].duplicated().any() or target["_key"].duplicated().any():
        raise ValueError("Natural transfer key is not unique; refusing an ambiguous join.")
    cohort = cohort.merge(
        target[["_key", "transfer_row_id", "window_start", "window_end", "post_appearances",
                "post_minutes", "post_goals", "post_assists", "post_GA90",
                "complete_365_day_window", "eligible_450min"]],
        on="_key", how="inner", validate="one_to_one"
    )
    if len(cohort) != len(target):
        raise ValueError(f"Transfer join lost rows: cohort={len(cohort)}, target={len(target)}")
    if rich["transfer_row_id"].duplicated().any():
        raise ValueError("rich_team_context_dataset.csv has duplicate transfer_row_id values")
    cohort = cohort.merge(
        rich.drop(columns=[c for c in cohort.columns if c in rich.columns and c != "transfer_row_id"], errors="ignore"),
        on="transfer_row_id", how="left", validate="one_to_one", suffixes=("", "_rich")
    )
    cohort["transfer_date"] = pd.to_datetime(cohort["transfer_date"], errors="coerce")
    for col in ["complete_365_day_window", "eligible_450min"]:
        cohort[col] = cohort[col].astype(str).str.strip().str.lower().isin({"true", "1", "yes"})
    if cohort["transfer_date"].isna().any():
        raise ValueError("Invalid transfer dates in canonical transfer cohort")
    return cohort


def load_appearances_and_seasons():
    apps = read_csv("appearances.csv", usecols=["appearance_id", "game_id", "player_id", "player_club_id", "date", "yellow_cards", "red_cards", "goals", "assists", "minutes_played"])
    games = read_csv("games.csv", usecols=["game_id", "date", "season", "competition_id"])
    apps["date"] = pd.to_datetime(apps["date"], errors="coerce")
    games["date"] = pd.to_datetime(games["date"], errors="coerce")
    for c in ["player_id", "player_club_id", "game_id", "minutes_played", "yellow_cards", "red_cards", "goals", "assists"]:
        apps[c] = pd.to_numeric(apps[c], errors="coerce")
    apps = apps.dropna(subset=["player_id", "game_id", "date"]).copy()
    duplicate_ids = int(apps["appearance_id"].duplicated().sum())
    apps = apps.drop_duplicates(subset=["appearance_id"], keep="first")
    games = games.drop_duplicates(subset=["game_id"], keep="first")
    apps = apps.merge(games[["game_id", "season", "competition_id"]], on="game_id", how="left", validate="many_to_one")
    apps["season_id"] = apps["season"].astype("Int64").astype(str)
    apps["season_id"] = apps["season_id"].replace("<NA>", np.nan)
    apps["season_mapping_status"] = np.where(apps["season_id"].notna(), "games.season", "unmapped")
    for c in ["minutes_played", "yellow_cards", "red_cards", "goals", "assists"]:
        apps[c] = apps[c].fillna(0)
    return apps, duplicate_ids


def load_starts():
    lineups = read_csv("game_lineups.csv", usecols=["game_id", "player_id", "date", "type"])
    games = read_csv("games.csv", usecols=["game_id", "season"])
    lineups["type_norm"] = lineups["type"].astype(str).str.lower().str.strip()
    lineups["is_start"] = lineups["type_norm"].isin({"starting_lineup", "starting xi", "starting_xi"})
    starts = lineups[lineups["is_start"]].drop_duplicates(["game_id", "player_id"])
    starts = starts.merge(games.drop_duplicates("game_id"), on="game_id", how="left", validate="many_to_one")
    starts["season_id"] = starts["season"].astype("Int64").astype(str).replace("<NA>", np.nan)
    season_starts = starts.groupby(["player_id", "season_id"], dropna=False, as_index=False).agg(starts=("game_id", "nunique"))
    total_starts = starts.groupby("player_id", as_index=False).agg(starts=("game_id", "nunique"))
    return season_starts, total_starts


def valuation_features(cohort, profiles):
    vals = read_csv("player_valuations.csv", usecols=["player_id", "date", "market_value_in_eur"])
    vals["date"] = pd.to_datetime(vals["date"], errors="coerce")
    vals["market_value_in_eur"] = pd.to_numeric(vals["market_value_in_eur"], errors="coerce")
    vals = vals.dropna(subset=["player_id", "date", "market_value_in_eur"])
    groups = {int(pid): g.sort_values("date") for pid, g in vals.groupby("player_id")}
    pre, post = [], []
    for row in cohort.itertuples():
        g = groups.get(int(row.player_id))
        if g is None:
            pre.append(np.nan); post.append(np.nan); continue
        before = g[g.date <= row.transfer_date]
        after = g[(g.date >= row.transfer_date) & (g.date <= row.transfer_date + pd.Timedelta(days=365))]
        pre.append(float(before.iloc[-1].market_value_in_eur) if len(before) else np.nan)
        post.append(float(after.iloc[-1].market_value_in_eur) if len(after) else np.nan)
    cohort["market_value_pre_transfer_observed"] = pre
    cohort["market_value_post_365_observed"] = post
    cohort["market_value_change_365"] = cohort["market_value_post_365_observed"] - cohort["market_value_pre_transfer_observed"]
    cohort["market_value_change_pct_365"] = np.where(
        cohort["market_value_pre_transfer_observed"] > 0,
        cohort["market_value_change_365"] / cohort["market_value_pre_transfer_observed"] * 100,
        np.nan,
    )
    cohort["fee_to_market_value_ratio"] = np.where(
        (cohort["transfer_fee"] > 0) & (cohort["market_value_pre_transfer_observed"] > 0),
        cohort["transfer_fee"] / cohort["market_value_pre_transfer_observed"], np.nan
    )
    cohort["attacking_output_per_million_fee"] = np.where(
        cohort["transfer_fee"] > 0,
        (cohort["post_goals"] + cohort["post_assists"]) / (cohort["transfer_fee"] / 1_000_000), np.nan
    )
    return cohort, vals


def build_statsbomb(players):
    out_dir = OUT / "statsbomb_enrichment"
    out_dir.mkdir(exist_ok=True)
    comp_path = SB_ROOT / "data" / "competitions.json"
    if not comp_path.exists():
        return pd.DataFrame(), pd.DataFrame()
    player_names = defaultdict(list)
    for r in players[["player_id", "name"]].dropna().itertuples(index=False):
        player_names[norm_text(r.name)].append(int(r.player_id))
    identity = {}
    statsbomb_names = set()
    lineup_files = list((SB_ROOT / "data" / "lineups").glob("*.json"))
    for p in lineup_files:
        try:
            with p.open("r", encoding="utf-8") as f:
                teams = json.load(f)
        except Exception:
            continue
        for team in teams if isinstance(teams, list) else []:
            for pl in team.get("lineup", []):
                name = pl.get("player_name", "")
                sid = pl.get("player_id")
                if not name or sid is None:
                    continue
                norm = norm_text(name); statsbomb_names.add(norm)
                ids = player_names.get(norm, [])
                identity[(int(sid), norm)] = ids[0] if len(ids) == 1 else np.nan
    audit_rows = []
    for sid, name in sorted(identity):
        ids = player_names.get(name, [])
        audit_rows.append({"statsbomb_player_id": sid, "statsbomb_name_normalized": name, "transfermarkt_player_id": ids[0] if len(ids) == 1 else np.nan, "match_status": "unique_exact" if len(ids) == 1 else ("ambiguous" if ids else "unmatched")})
    audit = pd.DataFrame(audit_rows)
    audit.to_csv(out_dir / "statsbomb_identity_audit.csv", index=False)
    metrics = defaultdict(lambda: Counter())
    event_files = list((SB_ROOT / "data" / "events").glob("*.json"))
    max_event_files = int(os.environ.get("STATSBOMB_MAX_EVENT_FILES", "0"))
    if max_event_files > 0:
        event_files = sorted(event_files)[:max_event_files]
    for p in event_files:
        try:
            with p.open("r", encoding="utf-8") as f:
                events = json.load(f)
        except Exception:
            continue
        for e in events if isinstance(events, list) else []:
            player = e.get("player") or {}
            sid, name = player.get("id"), player.get("name", "")
            if sid is None:
                continue
            tm_id = identity.get((int(sid), norm_text(name)), np.nan)
            if pd.isna(tm_id):
                continue
            tm_id = int(tm_id); typ = (e.get("type") or {}).get("name", "")
            m = metrics[tm_id]
            if "matches" not in m:
                m["matches"] = set()
            m["events"] += 1; m["matches"].add(p.stem)
            if typ == "Pass":
                m["passes"] += 1
                outcome = (e.get("pass") or {}).get("outcome")
                if not outcome: m["passes_completed"] += 1
                if (e.get("pass") or {}).get("shot_assist"): m["shot_assists"] += 1
                if (e.get("pass") or {}).get("goal_assist"): m["goal_assists"] += 1
            elif typ == "Shot":
                m["shots"] += 1
                outcome = ((e.get("shot") or {}).get("outcome") or {}).get("name", "")
                if outcome == "Goal": m["goals"] += 1
                if outcome in {"Goal", "Saved", "Off T"}: m["shots_on_target"] += 1
            elif typ == "Carry": m["carries"] += 1
            elif typ == "Dribble": m["dribbles"] += 1
            elif typ == "Interception": m["interceptions"] += 1
            elif typ == "Clearance": m["clearances"] += 1
            elif typ == "Block": m["blocks"] += 1
            elif typ == "Pressure": m["pressures"] += 1
            elif typ == "Duel":
                m["duels"] += 1
                subtype = ((e.get("duel") or {}).get("type") or {}).get("name", "")
                if "aerial" in subtype.lower(): m["aerial_duels"] += 1
            elif typ == "Goal Keeper": m["goalkeeper_events"] += 1
    rows = []
    for pid, c in metrics.items():
        row = {"player_id": pid, **{k: (len(v) if k == "matches" else v) for k, v in c.items()}}
        rows.append(row)
    sb = pd.DataFrame(rows)
    if not sb.empty:
        sb["passing_accuracy"] = np.where(sb["passes"] > 0, sb["passes_completed"] / sb["passes"], np.nan)
        sb.to_csv(out_dir / "statsbomb_player_event_metrics.csv", index=False)
    return sb, audit


def coverage_rows(profiles, seasons, transfers, sb, duplicate_appearance_ids):
    rows = []
    def add(metric, status, source, unit, window, total, eligible, nonmissing, notes=""):
        def as_int(value):
            value = pd.to_numeric(value, errors="coerce")
            return 0 if pd.isna(value) else int(value)
        total = as_int(total)
        eligible = as_int(eligible)
        nonmissing = as_int(nonmissing)
        rows.append({"metric": metric, "status": status, "source_columns": source, "unit": unit, "calculation_window": window, "total_records": total, "eligible_records": eligible, "nonmissing_records": nonmissing, "coverage_pct_of_total": round(100 * nonmissing / total, 2) if total else 0.0, "coverage_pct_of_eligible": round(100 * nonmissing / eligible, 2) if eligible else 0.0, "notes": notes})
    n = len(profiles)
    for metric, col in [("goals", "goals"), ("assists", "assists"), ("goal_contributions", "goal_contributions"), ("goals_per90", "goals_per90"), ("assists_per90", "assists_per90"), ("goal_contributions_per90", "goal_contributions_per90"), ("minutes_per_appearance", "minutes_per_appearance"), ("yellow_cards_per90", "yellow_cards_per90"), ("red_cards_per90", "red_cards_per90"), ("cards_per_appearance", "cards_per_appearance")]:
        denom = profiles["minutes"] > 0 if "per90" in metric else profiles["appearances"] > 0 if "appearance" in metric else profiles[col].notna()
        add(metric, "derived_from_existing_columns", "appearances.csv", "rate/count", "full observed appearance history", n, denom.sum(), profiles.loc[denom, col].notna().sum())
    add("starts", "derived_from_existing_columns", "game_lineups.csv:type", "appearances", "full observed history", n, n, profiles["starts"].notna().sum(), "Only starting_lineup records counted.")
    add("substitute_appearances", "derived_from_existing_columns", "appearances.csv - starts", "appearances", "full observed history", n, n, profiles["substitute_appearances"].notna().sum(), "Derived as total appearances minus verified starts; bench listings are not treated as appearances.")
    for metric, col in [("first_year_post_minutes", "post_minutes"), ("450_minute_outcome", "eligible_450min"), ("market_value_change_365", "market_value_change_365"), ("market_value_change_pct_365", "market_value_change_pct_365"), ("fee_to_market_value_ratio", "fee_to_market_value_ratio"), ("attacking_output_per_million_fee", "attacking_output_per_million_fee")]:
        n_valid = int(transfers[col].notna().sum())
        if metric in {"fee_to_market_value_ratio"}:
            eligible_n = int(((transfers["transfer_fee"] > 0) & (transfers["market_value_pre_transfer_observed"] > 0)).sum())
        elif metric in {"attacking_output_per_million_fee"}:
            eligible_n = int((transfers["transfer_fee"] > 0).sum())
        else:
            eligible_n = len(transfers)
        add(metric, "already_present" if metric in {"first_year_post_minutes", "450_minute_outcome"} else "derived_from_existing_columns", "post_transfer_performance.csv / player_valuations.csv / transfers.csv", "count/rate", "transfer-specific", len(transfers), eligible_n, n_valid, "Descriptive only; no causal value claim." if "output" in metric else "")
    add("season_attacking_and_availability", "derived_from_existing_columns", "appearances.csv + games.csv", "counts/rates", "verified games.season", len(seasons), len(seasons), seasons[["minutes", "appearances"]].notna().all(axis=1).sum())
    if sb is not None and not sb.empty:
        for col in [c for c in sb.columns if c not in {"player_id"}]: add(f"statsbomb_{col}", "derived_from_existing_columns", "StatsBomb events/*.json", "event count", "matched StatsBomb matches", len(sb), len(sb), sb[col].notna().sum(), "Exact normalized-name match only; separate limited-coverage subset.")
    for metric, note in [("passing_accuracy_full_cohort", "No Transfermarkt pass attempts/completions; StatsBomb subset only."), ("xG_xA_full_cohort", "No reliable full-cohort xG/xA source in local files."), ("goalkeeper_save_percentage_full_cohort", "No full-cohort saves/shots-on-target-faced fields.")]:
        add(metric, "not_calculable_current_data", "none", "not available", "not applicable", len(profiles), 0, 0, note)
    add("duplicate_appearance_ids_removed", "quality_check", "appearances.csv:appearance_id", "records", "source file", len(profiles), duplicate_appearance_ids, duplicate_appearance_ids, "Exact identifier duplicates were retained only once in the derived layer.")
    return pd.DataFrame(rows)


def main():
    cohort = load_transfer_cohort()
    apps, duplicate_appearance_ids = load_appearances_and_seasons()
    season_starts, starts = load_starts()
    players = read_csv("players.csv", usecols=["player_id", "name", "position", "sub_position", "foot", "height_in_cm", "date_of_birth"])
    players = players.drop_duplicates("player_id")
    app_groups = {int(pid): g.sort_values("date") for pid, g in apps.groupby("player_id")}

    # Player-season table based on the games.season field, not calendar-year inference.
    season = apps.groupby(["player_id", "season_id"], dropna=False).agg(
        appearances=("game_id", "nunique"), minutes=("minutes_played", "sum"), goals=("goals", "sum"), assists=("assists", "sum"), yellow_cards=("yellow_cards", "sum"), red_cards=("red_cards", "sum"),
        first_match_date=("date", "min"), last_match_date=("date", "max"), competitions=("competition_id", "nunique")
    ).reset_index()
    season = season.merge(players, on="player_id", how="left", validate="many_to_one")
    season = season.merge(season_starts, on=["player_id", "season_id"], how="left", validate="one_to_one")
    season["starts_raw"] = season["starts"].fillna(0)
    season["starts"] = np.where(season["starts_raw"] <= season["appearances"], season["starts_raw"], np.nan)
    season["substitute_appearances"] = np.where(season["starts"].notna(), season["appearances"] - season["starts"], np.nan)
    season = add_rates(season)
    season["reliability_warning"] = season.apply(lambda r: reliability(r, "minutes", "appearances"), axis=1)
    season.to_csv(OUT / "player_season_performance.csv", index=False)

    # Full observed player profiles.
    profiles = apps.groupby("player_id").agg(
        analysis_window_start=("date", "min"), analysis_window_end=("date", "max"), appearances=("game_id", "nunique"), minutes=("minutes_played", "sum"), goals=("goals", "sum"), assists=("assists", "sum"), yellow_cards=("yellow_cards", "sum"), red_cards=("red_cards", "sum"), seasons_observed=("season_id", "nunique")
    ).reset_index()
    profiles = profiles.merge(players, on="player_id", how="left", validate="one_to_one")
    profiles = profiles.merge(starts, on="player_id", how="left")
    profiles["starts_raw"] = profiles["starts"].fillna(0)
    profiles["starts"] = np.where(profiles["starts_raw"] <= profiles["appearances"], profiles["starts_raw"], np.nan)
    profiles["substitute_appearances"] = np.where(profiles["starts"].notna(), profiles["appearances"] - profiles["starts"], np.nan)
    profiles["profile_type"] = np.where(profiles["position"].eq("Goalkeeper"), "goalkeeper", "outfield")
    profiles = add_rates(profiles)
    rate_cols = ["goals_per90", "assists_per90", "goal_contributions_per90"]
    profiles = attach_percentiles(profiles, rate_cols, "position")
    profiles = attach_percentiles(profiles, rate_cols, "sub_position")
    profiles["reliability_warning"] = profiles.apply(lambda r: reliability(r, "minutes", "appearances", "position_peer_n"), axis=1)
    profiles.to_csv(OUT / "player_performance_profiles.csv", index=False)

    # Transfer-level before/after metrics.
    records = []
    for row in cohort.itertuples():
        pre = aggregate_window(app_groups, row, row.transfer_date - pd.Timedelta(days=365), row.transfer_date - pd.Timedelta(days=1))
        post = {"appearances": row.post_appearances, "minutes": row.post_minutes, "goals": row.post_goals, "assists": row.post_assists, "yellow_cards": np.nan, "red_cards": np.nan}
        rec = {"transfer_row_id": row.transfer_row_id, "player_id": row.player_id, "transfer_date": row.transfer_date, "from_club_id": row.from_club_id, "to_club_id": row.to_club_id, "from_club_name": row.from_club_name, "to_club_name": row.to_club_name, "position": row.position, "sub_position": row.sub_position, "transfer_fee": row.transfer_fee, "transfer_market_value": row.transfer_market_value, "market_value_pre": row.market_value_pre, "complete_365_day_window": row.complete_365_day_window, "eligible_450min": row.eligible_450min}
        for pfx, values in [("pre", pre), ("post", post)]:
            for k, v in values.items(): rec[f"{pfx}_{k}"] = v
        rec["pre_post_minutes_change"] = rec["post_minutes"] - rec["pre_minutes"]
        rec["pre_post_appearances_change"] = rec["post_appearances"] - rec["pre_appearances"]
        records.append(rec)
    transfers = pd.DataFrame(records)
    transfers = add_rates(transfers, "pre")
    transfers = add_rates(transfers, "post")
    transfers["post_450_minute_opportunity"] = transfers["eligible_450min"].astype(bool)
    transfers = transfers.merge(cohort[["transfer_row_id", "post_GA90"]], on="transfer_row_id", validate="one_to_one")
    transfers, valuations = valuation_features(transfers, profiles)
    transfers["reliability_warning_post"] = transfers.apply(lambda r: reliability(r, "post_minutes", "post_appearances"), axis=1)
    transfers.to_csv(OUT / "player_transfer_performance.csv", index=False)

    # Release the large appearance/valuation objects before parsing thousands
    # of StatsBomb JSON files. StatsBomb enrichment is deliberately a separate
    # limited-coverage layer and must not make the core pipeline fail.
    del app_groups, apps, valuations
    gc.collect()
    if os.environ.get("SKIP_STATSBOMB") == "1":
        sb, sb_audit = pd.DataFrame(), pd.DataFrame()
        print("StatsBomb pass skipped by SKIP_STATSBOMB=1")
    else:
        sb, sb_audit = build_statsbomb(players)
    coverage = coverage_rows(profiles, season, transfers, sb, duplicate_appearance_ids)
    coverage.to_csv(OUT / "metric_coverage.csv", index=False)

    dictionary = pd.DataFrame([
        {"metric": "goals", "definition": "Sum of recorded goals", "source_columns": "appearances.csv:goals", "unit": "goals", "grain": "player/window", "window": "observed, season, or transfer window"},
        {"metric": "assists", "definition": "Sum of recorded assists", "source_columns": "appearances.csv:assists", "unit": "assists", "grain": "player/window", "window": "observed, season, or transfer window"},
        {"metric": "goal_contributions_per90", "definition": "(goals + assists) * 90 / minutes", "source_columns": "goals, assists, minutes_played", "unit": "per 90 minutes", "grain": "player/window", "window": "rate is missing when minutes <= 0"},
        {"metric": "minutes_per_appearance", "definition": "minutes / appearances", "source_columns": "minutes_played, game_id", "unit": "minutes per appearance", "grain": "player/window", "window": "missing when appearances <= 0"},
        {"metric": "starts", "definition": "Unique games with lineup type starting_lineup", "source_columns": "game_lineups.csv:game_id,player_id,type", "unit": "starts", "grain": "player/observed history", "window": "full observed history"},
        {"metric": "substitute_appearances", "definition": "Appearance records minus verified starts", "source_columns": "appearances.csv and game_lineups.csv", "unit": "appearances", "grain": "player/observed history", "window": "not bench listings"},
        {"metric": "yellow_cards_per90", "definition": "yellow cards * 90 / minutes", "source_columns": "yellow_cards, minutes_played", "unit": "per 90 minutes", "grain": "player/window", "window": "missing when minutes <= 0"},
        {"metric": "red_cards_per90", "definition": "red cards * 90 / minutes", "source_columns": "red_cards, minutes_played", "unit": "per 90 minutes", "grain": "player/window", "window": "missing when minutes <= 0"},
        {"metric": "market_value_change_365", "definition": "Latest valuation within one year after transfer minus latest valuation on/before transfer", "source_columns": "player_valuations.csv:date,market_value_in_eur", "unit": "EUR", "grain": "transfer", "window": "transfer date to +365 days"},
        {"metric": "fee_to_market_value_ratio", "definition": "positive transfer fee / observed pre-transfer market value", "source_columns": "transfers.csv:transfer_fee and player_valuations.csv", "unit": "ratio", "grain": "transfer", "window": "descriptive only"},
        {"metric": "percentile_*", "definition": "Within-position or within-sub-position percentile among players meeting reliability thresholds", "source_columns": "derived rates, position, sub_position", "unit": "percentile 0-100", "grain": "player profile", "window": "full observed history"},
        {"metric": "season_id", "definition": "Verified season field joined from games.csv by game_id", "source_columns": "games.csv:game_id,season", "unit": "source season identifier", "grain": "player-season", "window": "football season, not calendar year"},
        {"metric": "statsbomb_event_metrics", "definition": "Event counts for exact unique normalized-name matches only", "source_columns": "StatsBomb events JSON", "unit": "event counts", "grain": "matched player", "window": "available StatsBomb matches only"},
    ])
    dictionary.to_csv(OUT / "data_dictionary.csv", index=False)

    # A compact reproducibility/example file, not a replacement for the full outputs.
    examples = profiles.sort_values(["minutes", "goal_contributions"], ascending=False).head(10)
    examples.to_csv(OUT / "example_player_profiles.csv", index=False)
    metadata = {"output_grains": {"player_performance_profiles.csv": "one row per player over full observed appearance history", "player_season_performance.csv": "one row per player per games.season value", "player_transfer_performance.csv": "one row per validated transfer_row_id", "metric_coverage.csv": "one row per metric/coverage check"}, "reliability_thresholds": {"minimum_minutes": MIN_MINUTES, "minimum_appearances": MIN_APPEARANCES, "minimum_peer_group": MIN_PEER_GROUP}, "natural_transfer_key": "player_id|transfer_date|from_club_id|to_club_id|transfer_season|transfer_fee", "statsbomb_match_method": "exact normalized player name, unique Transfermarkt target only", "source_rows": {"duplicate_appearance_ids_seen": duplicate_appearance_ids, "transfer_cohort": int(len(cohort)), "player_profiles": int(len(profiles)), "player_seasons": int(len(season)), "player_transfers": int(len(transfers))}}
    (OUT / "run_metadata.json").write_text(json.dumps(metadata, indent=2, default=str), encoding="utf-8")
    print(json.dumps(metadata, indent=2, default=str))
    print(f"Outputs written to: {OUT}")


if __name__ == "__main__":
    main()
